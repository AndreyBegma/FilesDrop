PORT=7347
APP_ENV=development
API_URL=http://localhost:7347
WEB_URL=http://localhost:4747

DATABASE_URL="postgresql://postgres:ti96rmFZaa9XIo8zdhFC@localhost:6543/filesdrop?schema=public"

# Files. Bytes live in UPLOAD_DIR: /data/uploads (volume) in prod, ./.uploads (git-ignored) in dev.
UPLOAD_DIR=./.uploads
# Quota over non-expired files, in bytes (10 GB).
MAX_TOTAL_BYTES=10737418240
# Uploads (file + URL combined) per client IP per window.
RATE_LIMIT=30
RATE_WINDOW_MS=600000
# true only behind Cloudflare: take the client IP from CF-Connecting-IP.
TRUST_CF_HEADER=false
