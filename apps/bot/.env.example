# The Telegram bot (apps/bot). Production values live in
# docker/docker-compose.prod.yml and the stack's .env (docker/stack.env.example).

# From @BotFather. Never logged.
TELEGRAM_BOT_TOKEN=
# The local Bot API server (`--local` mode).
TELEGRAM_API_ROOT=http://127.0.0.1:8081
# The cloud Bot API, only used once for logOut.
TELEGRAM_CLOUD_API_ROOT=https://api.telegram.org
# Same value as BOT_API_KEY in apps/api/.env.
BOT_API_KEY=
API_INTERNAL_URL=http://localhost:7347
PUBLIC_WEB_URL=http://localhost:4747
# The local Bot API server's working directory (its downloads).
TG_FILES_DIR=/var/lib/telegram-bot-api
# The bot's own data: languages.json (Telegram user id → en/uk). Must be
# writable; /var/lib/filesdrop-bot (the filesdrop-bot-data volume) in prod.
BOT_DATA_DIR=./.data
